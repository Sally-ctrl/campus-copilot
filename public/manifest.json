{
  "manifest_version": 3,
  "name": "Campus Copilot",
  "version": "0.1.0",
  "description": "Turns your university portal into a to-do list. Private by default with on-device Gemini Nano.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Campus Copilot" }
}
